{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "vite/client"
    ],
    "noEmit": true,
    "paths": {
      "live_vue": [
        "./deps/live_vue/assets/index.ts"
      ],
      "phoenix_live_view": [
        "./deps/phoenix_live_view/assets/js/types/index.d.ts"
      ]
    }
  },
  "include": [
    "assets/vue/**/*.ts",
    "assets/vue/**/*.vue"
  ]
}
