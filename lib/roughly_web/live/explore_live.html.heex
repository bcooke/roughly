<Layouts.app flash={@flash}>
  <section class="explore-intro">
    <h1>The world’s <span>percentages.</span></h1>
    <p>Search questions about people’s experiences, habits, and preferences.</p>
    <.form
      for={@form}
      id="question-search"
      action={~p"/"}
      method="get"
      phx-submit="search"
      phx-change="search"
      class="search-box"
    >
      <.input
        :if={@category != "All topics"}
        id="search-topic"
        type="hidden"
        name="topic"
        value={@category}
      />
      <.icon name="hero-magnifying-glass" class="size-5 text-stone-500" />
      <.input
        field={@form[:q]}
        id="search-query"
        type="search"
        placeholder="Search questions"
        aria-label="Search questions"
        phx-debounce="200"
      />
      <button type="submit" id="search-submit" aria-label="Search" class="search-submit"><.icon
        name="hero-arrow-right"
        class="size-5"
      /></button>
    </.form>
  </section>
  <section class="explore-content" aria-labelledby="explore-title">
    <div class="section-heading">
      <h2 id="explore-title">
        {cond do
          @search != "" -> "Search results"
          @category == "All topics" -> "All questions"
          true -> @category
        end}
      </h2><span id="question-count" class="result-count">{number(@count)} {if @count == 1,
        do: "question",
        else: "questions"}</span>
    </div>
    <p
      :if={@search != "" && @category != "All topics"}
      id="search-scope"
      class="mb-4 text-sm text-stone-600"
    >
      Searching in {@category}.
      <.link
        id="search-all-topics"
        patch={~p"/?#{filters(@search, "All topics")}"}
        class="text-link"
      >Search all topics</.link>
    </p>
    <nav aria-label="Question topics" class="topic-list">
      <.link
        id="topic-all-topics"
        patch={~p"/?#{filters(@search, "All topics")}"}
        aria-current={if @category == "All topics", do: "true"}
        class={["topic", @category == "All topics" && "topic-active"]}
      >All topics</.link>
      <.link
        :for={topic <- @topics}
        id={"topic-#{topic_id(topic.name)}"}
        patch={~p"/?#{filters(@search, topic.name)}"}
        aria-current={if topic.name == @category, do: "true"}
        class={["topic", topic.name == @category && "topic-active"]}
      >{topic.name} <span>{topic.count}</span></.link>
    </nav>
    <div id="questions" phx-update="stream" class="question-grid">
      <article :for={{id, question} <- @streams.questions} id={id} class="question-card">
        <div class="card-topline"><span>{question.category}</span></div>
        <.link navigate={~p"/questions/#{question.slug}"} class="question-link"><h3>
          {question.text}
        </h3></.link>
        <div class="mini-results" aria-hidden="true">
          <span
            :for={{answer, index} <- Enum.with_index(question.answers)}
            class={"answer-color-#{index}"}
            style={"width: #{answer.percentage}%"}
          ></span>
        </div>
        <div class="card-bottom">
          <span>{number(question.total)} {if question.total == 1,
            do: "response",
            else: "responses"}</span><.link
            navigate={~p"/questions/#{question.slug}"}
            class="view-results"
            aria-label={"View results: #{question.text}"}
          >View results <.icon name="hero-arrow-up-right" class="size-4" /></.link>
        </div>
      </article>
    </div>
    <div :if={@count == 0} id="empty-results" class="empty-results">
      <.icon name="hero-magnifying-glass" class="size-8" /><h3>No questions found</h3><p>
        Try another search or choose a different topic.
      </p><.link id="clear-filters" patch={~p"/"} class="text-link">Clear filters</.link>
    </div>
    <nav :if={@total_pages > 1} id="pagination" class="pagination" aria-label="Question pages">
      <.link
        :if={@page > 1}
        id="previous-page"
        patch={~p"/?#{filters(@search, @category, @page - 1)}"}
      ><.icon name="hero-arrow-left" class="size-4" /> Previous</.link>
      <span>Page {@page} of {@total_pages}</span>
      <.link
        :if={@page < @total_pages}
        id="next-page"
        patch={~p"/?#{filters(@search, @category, @page + 1)}"}
      >Next <.icon name="hero-arrow-right" class="size-4" /></.link>
    </nav>
  </section>
</Layouts.app>
