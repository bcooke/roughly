<Layouts.app flash={@flash}>
  <div :if={@question} class="question-page">
    <.link navigate={~p"/?#{%{topic: @question.category}}"} class="back-link"><.icon
      name="hero-arrow-left"
      class="size-4"
    /> {@question.category}</.link>
    <div class="question-heading">
      <h1 id="question-title">{@question.text}</h1><div class="question-meta">
        <span id="response-total">{number(@question.total)} {if @question.total == 1,
          do: "response",
          else: "responses"}</span><a href="#methodology">About these results</a>
      </div>
    </div>
    <div class="question-detail-grid">
      <section id="results" class="results-panel" aria-labelledby="results-title">
        <div class="section-heading">
          <h2 id="results-title">Responses</h2><a
            id="results-permalink"
            href={(~p"/questions/#{@question.slug}" <> "#results")}
            aria-label="Link to these results"
          ><.icon name="hero-link" class="size-5" /></a>
        </div>
        <div
          :for={{answer, index} <- Enum.with_index(@question.answers)}
          id={"answer-#{index}"}
          class="answer-row"
        >
          <div><span>{answer.label}</span><strong>{answer.percentage}%</strong></div><div class="answer-track">
            <div
              class={"answer-fill answer-color-#{index}"}
              style={"width: #{answer.percentage}%"}
            >
            </div>
          </div><p>
            {number(answer.count)} {if answer.count == 1, do: "response", else: "responses"}
          </p>
        </div>
        <p :if={@question.total == 0} id="no-responses" class="results-footnote">
          No responses yet.
        </p>
        <details id="methodology" class="result-methodology">
          <summary>About these results</summary><p>
            Each percentage is the share of responses to this question. Retracted responses are excluded. Results are unweighted.
          </p>
        </details>
        <.vue
          id="share-question"
          v-component="ShareQuestion"
          v-socket={@socket}
          v-ssr={false}
          path={(~p"/questions/#{@question.slug}" <> "#results")}
        />
      </section>
      <aside class="related-panel">
        <h2>More in {@question.category}</h2><div id="related-questions" phx-update="stream">
          <.link
            :for={{id, related} <- @streams.related}
            id={id}
            navigate={~p"/questions/#{related.slug}"}
            class="related-question"
          ><span>{related.text}</span><small>{number(related.total)} responses</small></.link>
        </div><.link navigate={~p"/?#{%{topic: @question.category}}"} class="text-link">Browse topic
        <.icon name="hero-arrow-right" class="size-4" /></.link>
      </aside>
    </div>
  </div>
  <section :if={!@question} id="question-not-found" class="empty-results">
    <h1>We couldn’t find that question.</h1><.link navigate={~p"/"} class="text-link">Back to all questions</.link>
  </section>
</Layouts.app>
