<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title
      default="An open collection of the world’s percentages"
      suffix=" · Roughly"
      phx-no-format
    >{assigns[:page_title]}</.live_title>
    <PhoenixVite.Components.assets
      :if={Application.get_env(:roughly, :serve_assets, true)}
      names={["js/app.js", "css/app.css"]}
      manifest={{:roughly, "priv/static/.vite/manifest.json"}}
      dev_server={PhoenixVite.Components.has_vite_watcher?(RoughlyWeb.Endpoint)}
      to_url={fn p -> static_url(@conn, p) end}
    />
  </head>
  <body>
    {@inner_content}
  </body>
</html>
